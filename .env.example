# Copy this file to .env.local for local development (vite dev will load it
# automatically). In production, set these as Environment Variables in your
# Vercel project settings instead — never commit real keys to git.

# --- Card payments (Stripe Checkout) ---
# Server-side only secret key. Get it from:
# https://dashboard.stripe.com/apikeys  (starts with sk_live_... or sk_test_...)
# Used only inside /api/create-checkout-session.js — never sent to the browser.
STRIPE_SECRET_KEY=

# --- PayPal ---
# This is your PUBLIC Client ID (safe to expose in the browser — it is not a
# secret). Get it from https://developer.paypal.com/dashboard/applications
# The VITE_ prefix is required for Vite to expose it to the frontend build.
# Leave unset to use PayPal's shared "test" sandbox client ID for local testing.
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
